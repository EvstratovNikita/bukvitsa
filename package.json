{
  "name": "wordle-ru",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:yandex": "node scripts/build-yandex.mjs",
    "build:vk": "node scripts/build-vk.mjs",
    "deploy:vk": "npm run build:vk && vk-miniapps-deploy",
    "fonts": "node scripts/fetch-fonts.mjs",
    "deploy:vk:auto": "npm run build:vk && node scripts/deploy-vk-auto.mjs",
    "deploy:vk:dev": "npm run build:vk && node scripts/deploy-vk-auto.mjs --dev",
    "deploy:vk:dev:halloween": "node scripts/build-vk.mjs --event-preview && node scripts/deploy-vk-auto.mjs --dev",
    "build:playgama": "node scripts/build-en.mjs playgama",
    "build:gamemonetize": "node scripts/build-en.mjs gamemonetize",
    "build:telegram": "node scripts/build-en.mjs telegram",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "@vkontakte/vk-bridge": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@vkontakte/vk-miniapps-deploy": "^1.0.2",
    "naughty-words": "^1.2.0",
    "vite": "^5.4.0",
    "wordlist-english": "^1.2.1"
  }
}
