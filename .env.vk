# Сборка для VK Mini Apps (npm run build:vk).
#
# Пустые значения ГАСЯТ Supabase: isSupabaseConfigured=false, клиент не
# создаётся, анонимного входа нет, URL и ключ проекта в архив не попадают.
# На площадке прогресс лежит в облаке VK (VKWebAppStorageSet, с разбивкой на
# части — см. lib/vk.js), а экономика считается локально: серверные RPC там
# отключены через isEmbedded (см. lib/economy.js).
#
# Vite отдаёт .env.[mode] приоритет над .env.local, так что локальные
# credentials веб-версии сюда не протекут.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Общая таблица лидеров (supabase/vk_leaderboard.sql). Клиент Supabase здесь
# по-прежнему выключен: таблица читается и пишется двумя POST-запросами к
# PostgREST (см. lib/scores.js), а не через пакет.
#
# Значения кладутся в .env.vk.local — он не в репозитории, ровно как
# .env.local у веб-версии. Vite отдаёт *.local приоритет над этим файлом:
#
#   VITE_SCORES_URL=https://<ref>.supabase.co
#   VITE_SCORES_KEY=sb_publishable_...
#
# Без них пункт «Лучшие игроки» в меню не показывается вовсе.
VITE_SCORES_URL=
VITE_SCORES_KEY=
